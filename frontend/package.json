{
  "name": "gbwindblade-frontend",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "typecheck": "vue-tsc --noEmit",
    "preview": "vite preview --port 22801",
    "verify:merge": "node -e \"const esbuild=require('esbuild');esbuild.build({entryPoints:['scripts/verify-merge.mts'],bundle:true,platform:'node',format:'esm',outfile:'scripts/.verify-merge.mjs',alias:{'@':'./src'},logLevel:'warning'}).then(()=>console.log('bundled'))\" && node scripts/.verify-merge.mjs"
  },
  "dependencies": {
    "@element-plus/icons-vue": "^2.3.1",
    "dexie": "^4.0.11",
    "element-plus": "^2.9.5",
    "pinia": "^2.3.1",
    "vue": "^3.5.13",
    "vue-router": "^4.5.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "@vitejs/plugin-vue": "^5.2.1",
    "fake-indexeddb": "^6.2.5",
    "typescript": "~5.7.3",
    "vite": "^6.1.0",
    "vue-tsc": "^2.2.0"
  }
}
